{
  "name": "sankara-pexapp-ops-workspace",
  "version": "2.0.0",
  "description": "Sankara Eye Care Institutions - Project Patient Experience (PPE) Operations App",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix pxapp run dev",
    "build": "npm --prefix pxapp run build",
    "start": "npm --prefix pxapp run start",
    "db:init": "npm --prefix pxapp run db:init",
    "db:seed": "npm --prefix pxapp run db:seed",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop sankara-pexapp",
    "pm2:restart": "pm2 restart sankara-pexapp",
    "pm2:logs": "pm2 logs sankara-pexapp",
    "pm2:status": "pm2 status",
    "lint": "npm --prefix pxapp run lint"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.21.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}

