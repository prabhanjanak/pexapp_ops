PORT=3000

# ==============================================================================
# POSTGRESQL DATABASE CREDENTIALS
# ==============================================================================
# Option 1: Full Connection String URL (Optional)
# DATABASE_URL=postgresql://postgres:YourSecurePassword@localhost:5432/sankara_px

# Option 2: Individual Parameters
