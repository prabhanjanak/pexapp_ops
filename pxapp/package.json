{
  "name": "sankara-pexapp-ops",
  "private": true,
  "version": "2.0.0",
  "description": "Sankara Eye Care Institutions - Project Patient Experience (PPE) Operations App",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,VITE\" -c \"yellow,cyan\" \"tsx watch server/index.ts\" \"vite --port=3000 --host=0.0.0.0\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "server": "tsx watch server/index.ts",
    "client": "vite --port=3000 --host=0.0.0.0",
    "preview": "vite preview",
    "db:init": "tsx server/initDb.ts",
    "db:seed": "tsx server/initDb.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop sankara-pexapp",
    "pm2:restart": "pm2 restart sankara-pexapp",
    "pm2:logs": "pm2 logs sankara-pexapp",
    "pm2:status": "pm2 status",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.185.1",
    "three-globe": "^2.45.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.21.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
